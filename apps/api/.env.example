# Copy to .env. Leave MONGODB_URI empty to run a local MongoDB automatically (data in apps/api/.data).
PORT=4000
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
REFRESH_TOKEN_DAYS=30
ACCESS_TOKEN_MINUTES=15
COURIER_WEBHOOK_SECRET=change-me-courier-secret
# Dev only: automatically advance new orders through each status so you can watch live tracking
DEMO_AUTO_ADVANCE_SECONDS=20
